# Keep disabled until the destination and public fields have been reviewed.
MONITOR_ENABLED=false
MONITOR_SAMPLE_SECONDS=15
MONITOR_STATE_DIR=./state
MONITOR_LOCAL_RETENTION_DAYS=7

# Empty = discover interfaces with a default IPv4/IPv6 route; never sum Docker bridges.
# Interface/device names are local configuration and are never published.
MONITOR_INTERFACES=
# Empty = detect the block device containing MONITOR_DISK_PATH, when possible.
MONITOR_DISK_DEVICES=
MONITOR_DISK_PATH=/

# Only upload needs boto3 and these settings. HTTPS endpoints only.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=monitoring/server-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# auto, path, or virtual (provider dependent).
S3_ADDRESSING_STYLE=auto
# Bounded backlog processing per invocation, most recent hours first.
MONITOR_UPLOAD_MAX_HOURS=12
